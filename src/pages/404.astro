---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page introuvable">
	<section class="pt-40 pb-20 text-center">
		<h1 class="text-4xl md:text-5xl font-bold mb-4">Page introuvable</h1>
		<p class="text-gray-600 mb-8">Cette page n'existe pas ou a été déplacée.</p>
		<a
			href="/travail"
			class="inline-block px-6 py-3 border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300"
		>
			Voir mon travail
		</a>
	</section>
</MainLayout>
